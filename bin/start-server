#!/bin/bash

# Script to start the Flask server on an available port

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_DIR="$( cd "$SCRIPT_DIR/.." && pwd )"

# Function to check if a port is in use
check_port() {
    local port=$1
    if lsof -Pi :$port -sTCP:LISTEN -t >/dev/null 2>&1 ; then
        return 1  # Port is in use
    else
        return 0  # Port is available
    fi
}

# Find an available port starting from 5000
PORT=5000
MAX_PORT=5100

while [ $PORT -le $MAX_PORT ]; do
    if check_port $PORT; then
        echo "✓ Port $PORT is available"
        break
    else
        echo "✗ Port $PORT is in use, trying next port..."
        PORT=$((PORT + 1))
    fi
done

if [ $PORT -gt $MAX_PORT ]; then
    echo "Error: Could not find an available port between 5000 and $MAX_PORT"
    exit 1
fi

# Export the port as an environment variable
export FLASK_PORT=$PORT

# Change to project directory
cd "$PROJECT_DIR"

# Check if virtual environment exists, if not suggest creating one
if [ ! -d "venv" ] && [ ! -d ".venv" ]; then
    echo "Warning: No virtual environment found. Consider creating one:"
    echo "  python3 -m venv venv"
    echo "  source venv/bin/activate"
    echo "  pip install -r requirements.txt"
    echo ""
fi

# Start the Flask server
echo "Starting Flask server on port $PORT..."
echo "API will be available at: http://localhost:$PORT"
echo "Health check: http://localhost:$PORT/api/health"
echo ""
echo "Press Ctrl+C to stop the server"
echo ""

# Run Flask with the determined port
python3 -c "
import sys
import os
sys.path.insert(0, os.path.dirname(os.path.abspath('$PROJECT_DIR/app.py')))
from app import app
port = int(os.environ.get('FLASK_PORT', 5000))
app.run(debug=True, port=port, host='0.0.0.0')
"

